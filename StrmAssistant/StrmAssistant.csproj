<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <!-- 版本号与 Releases 仓库的 tag 体系保持一致（v3.0.0.x），显示为 3.0.0.65 -->
    <AssemblyVersion>3.0.0.65</AssemblyVersion>
    <FileVersion>3.0.0.65</FileVersion>
    <Version>3.0.0.65</Version>
    <InformationalVersion>3.0.0.65</InformationalVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Tokenizer\linux\libsimple.so" />
    <None Remove="Tokenizer\linux-arm64\libsimple.so" />
    <None Remove="Tokenizer\win\libsimple.so" />
    <None Remove="Web\Resources\strmassistant.js" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties\thumb.png" />
    <EmbeddedResource Include="Tokenizer\linux\libsimple.so" />
    <EmbeddedResource Include="Tokenizer\linux-arm64\libsimple.so" />
    <EmbeddedResource Include="Tokenizer\win\libsimple.so" />
    <EmbeddedResource Include="Web\Resources\strmassistant.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CHTCHSConv" Version="1.0.0">
    </PackageReference>
    <PackageReference Include="DiscUtils.Udf" Version="0.16.13">
      <!-- 跨平台 ISO 读取（MIT）；传递引入 DiscUtils.Core / DiscUtils.Streams / DiscUtils.Iso9660 -->
    </PackageReference>
    <PackageReference Include="ILRepack" Version="2.0.42">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="mediabrowser.server.core" Version="4.9.1.90">
      <!-- 当前支持4.9.1.0及更高版本 -->
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Resource.Embedder" Version="2.2.0" />
    <PackageReference Include="SQLitePCL.pretty.core" Version="1.2.2" />
    <PackageReference Include="TinyPinyin" Version="1.1.0">
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-hant.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup>
    <!-- 可通过 /p:StrmAssistantPluginOutputDir=... 覆盖部署目录 -->
    <!-- 默认指向**实际运行**的 4.10.1.0 实例（旧的 4.9.1 实例在 D:\Downloads\embyserver，需显式覆盖） -->
    <StrmAssistantPluginOutputDir Condition="'$(StrmAssistantPluginOutputDir)'=='' and '$(OS)'=='Windows_NT'">D:\下载\embyserver-win-x64-4.10.1.0\programdata\plugins</StrmAssistantPluginOutputDir>

    <!-- 显式拼接输出目录，避免 Build 目标里 TargetPath/TargetDir 为空 -->
    <StrmAssistantBuildOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\</StrmAssistantBuildOutputDir>
    <StrmAssistantMergedAssembly>$(StrmAssistantBuildOutputDir)$(AssemblyName).dll</StrmAssistantMergedAssembly>
    <!-- 发布包命名：StrmAssistantPlus_v3.0.0.60.dll；部署文件名保持 StrmAssistant.dll，避免多版本副本被 Emby 同时加载 -->
    <StrmAssistantPackageAssembly>$(StrmAssistantBuildOutputDir)StrmAssistantPlus_v$(Version).dll</StrmAssistantPackageAssembly>

    <!-- ILRepack 可执行文件：优先使用 NuGet 包目录，避免 $(ILRepack) 这类空属性 -->
    <ILRepackExe Condition="'$(ILRepackExe)'=='' and '$(NuGetPackageRoot)'!=''">$(NuGetPackageRoot)ilrepack\2.0.42\tools\ILRepack.exe</ILRepackExe>
    <ILRepackExe Condition="'$(ILRepackExe)'=='' and '$(UserProfile)'!=''">$(UserProfile)\.nuget\packages\ilrepack\2.0.42\tools\ILRepack.exe</ILRepackExe>
  </PropertyGroup>

  <!-- 资源键一致性校验 + 自动修复：Emby 的 DisplayNameL/DescriptionL 走反射查 Resources 公共静态属性，
       而 Resources.Designer.cs 不会由 dotnet build 重新生成。忘记同步会导致设置页 500。
       传 fix 开关：把「代码引用 + resx 有 + Designer 缺」的属性自动补进 Designer（幂等）；
       其余问题（resx 缺键、缺译文）仍然打印 [FAIL] 提示。
       ContinueOnError：只提示不阻断构建（本地无 python 时也不影响编译）。 -->
  <Target Name="CheckResxKeys" BeforeTargets="CoreCompile"
          Condition="Exists('$(MSBuildProjectDirectory)\..\tools\check_resx_keys.py')">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\tools\check_resx_keys.py&quot; --quiet --fix"
          ContinueOnError="true" StandardOutputImportance="high" StandardErrorImportance="high" />
  </Target>

  <Target Name="PostBuildMerge" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <Message Importance="high" Text="StrmAssistant: build output dir -> $(StrmAssistantBuildOutputDir)" />
    <Message Importance="high" Text="StrmAssistant: ILRepack merge -> $(StrmAssistantMergedAssembly)" />
    <Message Importance="high" Text="StrmAssistant: ILRepack exe -> $(ILRepackExe)" />
    <Exec Command="&quot;$(ILRepackExe)&quot; /out:&quot;$(StrmAssistantMergedAssembly)&quot; &quot;$(StrmAssistantMergedAssembly)&quot; &quot;$(StrmAssistantBuildOutputDir)0Harmony.dll&quot; &quot;$(StrmAssistantBuildOutputDir)ChineseConverter.dll&quot; &quot;$(StrmAssistantBuildOutputDir)TinyPinyin.dll&quot; &quot;$(StrmAssistantBuildOutputDir)DiscUtils.Core.dll&quot; &quot;$(StrmAssistantBuildOutputDir)DiscUtils.Streams.dll&quot; &quot;$(StrmAssistantBuildOutputDir)DiscUtils.Udf.dll&quot; &quot;$(StrmAssistantBuildOutputDir)DiscUtils.Iso9660.dll&quot; /lib:&quot;$(StrmAssistantBuildOutputDir)&quot;" />

    <Copy SourceFiles="$(StrmAssistantMergedAssembly)"
          DestinationFiles="$(StrmAssistantPackageAssembly)"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="StrmAssistant: versioned package -> $(StrmAssistantPackageAssembly)" />

    <MakeDir Condition="'$(StrmAssistantPluginOutputDir)'!=''" Directories="$(StrmAssistantPluginOutputDir)" />
    <Copy Condition="'$(StrmAssistantPluginOutputDir)'!=''"
          SourceFiles="$(StrmAssistantMergedAssembly)"
          DestinationFiles="$(StrmAssistantPluginOutputDir)\$(TargetFileName)"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
    <Message Condition="'$(StrmAssistantPluginOutputDir)'!=''" Importance="high" Text="StrmAssistant: deployed merged plugin -> $(StrmAssistantPluginOutputDir)\$(TargetFileName)" />
    <Message Condition="'$(StrmAssistantPluginOutputDir)'==''" Importance="normal" Text="StrmAssistant: skip auto-deploy (set /p:StrmAssistantPluginOutputDir=... if needed)." />
  </Target>
</Project>
